# Demo environment template (REQ-DEMO-003). `make up` copies it to .env when .env is missing.
# Do not commit .env, .env.dev or .env.*.local files.

###> symfony/framework-bundle ###
# APP_ENV: Symfony environment (dev/test/prod). The demo runs in `dev` (Web Profiler, Twig Inspector, Hot Reload).
APP_ENV=dev

# APP_SECRET: Secret used for CSRF/session signing. Local-only placeholder; never reuse in production.
APP_SECRET=change_this_secret_key_to_a_random_value

# APP_DEBUG: Enable detailed debug output (1 in dev, 0 in prod).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker
###< symfony/framework-bundle ###

# PORT: Host port mapped to the FrankenPHP (Caddy) HTTP service in docker-compose.yml.
PORT=8060

# DEFAULT_URI: Base URL used to generate absolute URLs from the CLI; keep it in sync with PORT.
DEFAULT_URI=http://localhost:8060

###> doctrine/doctrine-bundle ###
# DATABASE_URL: Doctrine DSN for the demo MySQL service (`database` host inside Compose, REQ-DEMO-011).
DATABASE_URL=mysql://app:app@database:3306/app?serverVersion=8.4&charset=utf8mb4
###< doctrine/doctrine-bundle ###
