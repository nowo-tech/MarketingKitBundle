{% extends 'base.html.twig' %}

{% block title %}Marketing Kit Demo{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_marketing_kit_admin_index') }}">Open marketing services</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Marketing Kit Demo', intro: 'Database config is enabled. Configure marketing services in the admin CRUD.', toolbar: _toolbar|trim}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Marketing services', intro: 'List, seed the catalog, import the YAML profile, edit provider IDs and toggle each service on or off.', kind: 'content'} %}
        {% block section_body %}
            <p><a class="nowo-ui-link" href="{{ path('nowo_marketing_kit_admin_index') }}">/admin/marketing</a></p>
            <p class="nowo-ui-muted">After seeding, enable the services you need and set their IDs (GTM, Clarity, …). View the page source to inspect the rendered tags.</p>
        {% endblock %}
    {% endembed %}
{% endblock %}
