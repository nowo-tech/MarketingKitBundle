{#
  Demo host layout (REQ-UI-003 nowo_ui_kit.layouts.admin): the UiKit admin layout plus a small demo masthead in
  nowo_ui_navigation and Bootstrap Icons (demo asset; the bundle ships no layout and no CDN link). Every Marketing
  Kit admin page (UiKit list / form scaffolds) renders inside it.
#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_styles %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {{ parent() }}
    <style>
        body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
        .nowo-ui-content { padding: 1.25rem 1.5rem 2rem; }
        .demo-masthead { display: flex; align-items: center; gap: 1.5rem; padding: .75rem 1.5rem; background: #0f172a; color: #e2e8f0; }
        .demo-masthead a { color: inherit; text-decoration: none; }
        .demo-masthead__brand { font-weight: 700; letter-spacing: .01em; }
        .demo-masthead__nav { display: flex; gap: 1rem; font-size: .925rem; }
        .demo-masthead__nav a:hover, .demo-masthead__nav a[aria-current="page"] { color: #fff; text-decoration: underline; text-underline-offset: .25em; }
        .demo-masthead__note { margin-left: auto; font-size: .8rem; color: #94a3b8; }
    </style>
{% endblock %}

{% block nowo_ui_navigation %}
    <header class="demo-masthead">
        <a class="demo-masthead__brand" href="{{ path('demo_home') }}">Marketing Kit demo</a>
        <nav class="demo-masthead__nav" aria-label="Demo">
            <a href="{{ path('demo_home') }}">Home</a>
            <a href="{{ path('nowo_marketing_kit_admin_index') }}" aria-current="page">Marketing services</a>
        </nav>
        <span class="demo-masthead__note">Symfony 8 · FrankenPHP</span>
    </header>
{% endblock %}
