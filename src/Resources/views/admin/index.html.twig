{#
  Marketing services admin list (REQ-UI-003): UiKit list scaffold.
  View model: page (View\ListPage, MarketingKitPages::listPage()): header actions Add service (GET), Seed catalog and
  Import from YAML (POST + CSRF-only FormView); filters = the GET profile switcher (ProfileFilterType); one row per
  tool: id, name, code, type, category, position, enabled, options (key => shortened value); row actions Edit,
  Enable / Disable (POST + CSRF) and Delete (POST + CSRF behind the UiKit confirm dialog).
  Extra variables (1.x, kept for web_ui.templates overrides): tools, profile, profiles, catalog, use_database_config,
  profile_form, seed_form, import_form, toggle_forms, delete_forms.
  Data blocks: nowo_ui_list_row (cells); nowo_ui_content prepends the use_database_config notice (flash_warning).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}

{% block nowo_ui_content %}
    {% if not use_database_config|default(true) %}
        <div class="{{ nowo_ui_class('flash_warning', page.bundle) }}" role="status" data-testid="marketing-kit-db-config-hint">{{ 'admin.db_config_hint'|trans({}, 'NowoMarketingKitBundle') }}</div>
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block nowo_ui_list_row %}
    {%- set _b = page.bundle -%}
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'admin.col.service'|trans({}, 'NowoMarketingKitBundle') }}" data-required="1">
        <strong>{{ row.name }}</strong>
        <span class="{{ nowo_ui_class('muted', _b) }}"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.code }}</code></span>
    </td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'admin.col.type'|trans({}, 'NowoMarketingKitBundle') }}"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.type }}</code></td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'admin.col.category'|trans({}, 'NowoMarketingKitBundle') }}" data-nowo-ui-priority="2">{{ row.category }}</td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'admin.col.position'|trans({}, 'NowoMarketingKitBundle') }}" data-nowo-ui-priority="2">{{ row.position }}</td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}" data-label="{{ 'admin.col.enabled'|trans({}, 'NowoMarketingKitBundle') }}">
        <span class="{{ nowo_ui_class(row.enabled ? 'badge_success' : 'badge_neutral', _b) }}" data-testid="marketing-kit-state-{{ row.code }}">{{ (row.enabled ? 'admin.on' : 'admin.off')|trans({}, 'NowoMarketingKitBundle') }}</span>
    </td>
    <td class="{{ nowo_ui_class('table_cell', _b) }}{{ row.options is empty ? ' ' ~ nowo_ui_class('table_cell_muted', _b) }}" data-label="{{ 'admin.col.options'|trans({}, 'NowoMarketingKitBundle') }}" data-nowo-ui-priority="3">
        {% for key, value in row.options %}
            <div><span class="{{ nowo_ui_class('muted', _b) }}">{{ key }}:</span> {{ value is same as('') ? '—' : value }}</div>
        {% else %}
            —
        {% endfor %}
    </td>
{% endblock %}
