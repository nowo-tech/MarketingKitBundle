{% extends '@NowoMarketingKitBundle/admin/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_marketing_kit_css_framework|default('none') %}

{% block title %}{{ (is_new ? 'admin.new' : 'admin.edit')|trans({}, 'NowoMarketingKitBundle') }}{% endblock %}

{% block body %}
    <div class="mk-header nowo-ui-header">
        <div>
            <h1>{{ (is_new ? 'admin.new' : 'admin.edit')|trans({}, 'NowoMarketingKitBundle') }}</h1>
            <p class="mk-lead">{{ catalog.labelForCode(tool.code) }} · <code>{{ tool.type }}</code></p>
        </div>
        <a class="{{ ui.btn('secondary', null, _css_fw) }} mk-btn nowo-ui-action-cancel" href="{{ path('nowo_marketing_kit_admin_index', {profile: tool.profile}) }}">{{ 'admin.back'|trans({}, 'NowoMarketingKitBundle') }}</a>
    </div>

    {% if not use_database_config %}
        <div class="mk-alert mk-alert-warn nowo-ui-flash">
            {{ 'admin.db_config_hint'|trans({}, 'NowoMarketingKitBundle') }}
        </div>
    {% endif %}

    {{ form_start(form, {attr: {class: 'mk-form nowo-ui-form'}}) }}
        {{ form_row(form.profile) }}
        {{ form_row(form.code) }}
        {{ form_row(form.type) }}
        {{ form_row(form.enabled) }}
        {{ form_row(form.category) }}
        {{ form_row(form.position) }}
        {{ form_row(form.sortOrder) }}

        <fieldset class="mk-fieldset">
            <legend>{{ 'admin.provider_options'|trans({}, 'NowoMarketingKitBundle') }}</legend>
            {% for child in form %}
                {% if child.vars.name starts with 'option_' %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        </fieldset>

        <div class="mk-form-actions nowo-ui-form-actions">
            <button type="submit" class="{{ ui.btn('primary', null, _css_fw) }} mk-btn mk-btn-primary nowo-ui-action-save">{{ 'admin.save'|trans({}, 'NowoMarketingKitBundle') }}</button>
            <a class="{{ ui.btn('secondary', null, _css_fw) }} mk-btn nowo-ui-action-cancel" href="{{ path('nowo_marketing_kit_admin_index', {profile: tool.profile}) }}">{{ 'admin.cancel'|trans({}, 'NowoMarketingKitBundle') }}</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
