{#
  Marketing service create / edit form (REQ-UI-003): UiKit form scaffold.
  View model: page (View\FormPage, MarketingKitPages::formPage()): header admin.new / admin.edit, intro = service
  label and provider type, back link and cancel = the list of the tool profile; form = MarketingToolType;
  formThemes = web_ui.form_themes.
  Extra variables (1.x, kept for web_ui.templates overrides): form, tool, is_new, catalog, use_database_config.
  Data blocks: nowo_ui_form_body — the REQ-TWIG-003 child loop for the common fields, then the provider options
  (option_* children) in their own fieldset; nowo_ui_content prepends the use_database_config notice.
#}
{% extends '@NowoUiKit/page/form.html.twig' %}

{% block nowo_ui_content %}
    {% if not use_database_config|default(true) %}
        <div class="{{ nowo_ui_class('flash_warning', page.bundle) }}" role="status" data-testid="marketing-kit-db-config-hint">{{ 'admin.db_config_hint'|trans({}, 'NowoMarketingKitBundle') }}</div>
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block nowo_ui_form_body %}
    {# REQ-TWIG-003: child loop; the provider options (option_*) are grouped in the fieldset below #}
    {% for child in form %}
        {% if not child.rendered and not (child.vars.name starts with 'option_') %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}
    <fieldset class="{{ nowo_ui_class('section', page.bundle) }}" data-testid="marketing-kit-provider-options">
        <legend>{{ 'admin.provider_options'|trans({}, 'NowoMarketingKitBundle') }}</legend>
        {% for child in form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    </fieldset>
{% endblock %}
