{# Admin pages extend this shell; configure web_ui.layout_template for host chrome (REQ-UI-001).
   When the host sets layout_template, stack assets via parent(). Demo root remains admin/layout.html.twig. #}
{% extends nowo_marketing_kit_layout|default('@NowoMarketingKitBundle/admin/layout.html.twig') %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_marketing_kit_css_framework|default('none') %}

{% block nowo_ui_flashes %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {% set _flash_type = label == 'success' ? 'success' : (label == 'error' ? 'error' : 'warning') %}
            <div class="{{ ui.flash(_flash_type, _css_fw) }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% block nowo_ui_styles %}
        <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    {% endblock %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% block nowo_ui_scripts %}{% endblock %}
{% endblock %}
